# Local backend environment for Hostillam lead notifications.
# Never commit real secrets. Copy to .env and fill in values.

PORT=3001

# Host notification channels: WHATSAPP,EMAIL (comma-separated)
NOTIFICATION_CHANNELS=WHATSAPP,EMAIL

# Host contact (server-side only)
HOST_WHATSAPP_NUMBER=919747232233
HOST_EMAIL=hello@hostillam.com

# WhatsApp Business Cloud API (optional — when unset, notifications are logged)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Email SMTP fallback (optional — when unset, emails are logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hostillam Leads <noreply@hostillam.com>

# Instagram auto reels feed (public profile username)
INSTAGRAM_USERNAME=host.illam
INSTAGRAM_APP_ID=936619743392459
